import java.nio.file.Files;
String report = Files.readString(new File(basedir, "target/architecture/source-report.txt").toPath());
if (!report.startsWith("PASSED\n") || !report.contains("sourceFiles=3")) throw new IllegalStateException(report);
if (!new File(basedir, "target/generated-sources/annotations/consumer/example/infra/orders/mappers/OrderMapperImpl.java").isFile()) {
    throw new IllegalStateException("MapStruct must actually generate its implementation");
}
if (!new File(basedir, "target/classes/consumer/example/infra/orders/mappers/OrderMapperImpl.class").isFile()) {
    throw new IllegalStateException("Generated bytecode must be available for analysis");
}
return true;

import java.nio.file.Files;
String report = Files.readString(new File(basedir, "target/architecture/source-report.txt").toPath());
if (!report.startsWith("PASSED\n") || !report.contains("basePackage=consumer.example") || !report.contains("sourceFiles=1")) {
    throw new IllegalStateException("Expected a successful consumer analysis: " + report);
}
for (String rule : new String[] {"RequireTypeImports", "AvoidOptionalGet", "DomainMethodsMustNotReturnNull", "AggregateInvariantSetter"}) {
    if (!report.contains(rule)) throw new IllegalStateException("Missing executed rule " + rule);
}
String log = Files.readString(new File(basedir, "build.log").toPath());
if (log.contains("--- surefire:")) throw new IllegalStateException("The gate must execute before Surefire");
return true;
